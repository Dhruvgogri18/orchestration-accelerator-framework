{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestration-accelerator/schemas/workflow_spec.schema.json",
  "title": "Workflow Specification",
  "description": "The locked, schema-validated document produced by Stage 3.5 enrichment. This is the single source of truth Stage 4 translates into ASL -- nothing in ASL generation should require information that isn't here.",
  "type": "object",
  "required": [
    "name",
    "summary",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-_]{1,80}$",
      "description": "Becomes the Step Functions state machine name. AWS-safe characters only."
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "start_at": {
      "type": "string"
    },
    "merged_step_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Step ids from the input plan that were deliberately merged into a preceding step (e.g. a retry-only step folded into the step it retries) rather than emitted as their own state. Not part of ASL itself -- consumed by enrichment's fidelity check, not by Stage 4."
    },
    "added_step_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "NEW step ids not present in the input plan, added because ASL structurally required a minimal terminal target (Succeed/Fail only) for an outcome the plan never gave its own step. Not part of ASL itself -- consumed by enrichment's fidelity check, not by Stage 4."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "branch": {
      "type": "object",
      "required": [
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "start_at": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "retrier": {
      "type": "object",
      "required": [
        "error_equals"
      ],
      "additionalProperties": false,
      "properties": {
        "error_equals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 0,
          "default": 3
        },
        "backoff_rate": {
          "type": "number",
          "minimum": 1,
          "default": 2.0
        }
      }
    },
    "catcher": {
      "type": "object",
      "required": [
        "error_equals",
        "next_step"
      ],
      "additionalProperties": false,
      "properties": {
        "error_equals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "result_path": {
          "type": "string",
          "description": "ASL Catch ResultPath: where the error object is written on state before transitioning (e.g. '$.chargeError')."
        },
        "next_step": {
          "type": "string"
        }
      }
    },
    "choice_rule": {
      "type": "object",
      "required": [
        "condition",
        "next_step"
      ],
      "additionalProperties": false,
      "properties": {
        "condition": {
          "type": "string"
        },
        "next_step": {
          "type": "string"
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{1,80}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "Task",
            "Choice",
            "Wait",
            "Parallel",
            "Map",
            "Succeed",
            "Fail",
            "Pass"
          ]
        },
        "description": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "retry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/retrier"
          }
        },
        "catch": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catcher"
          }
        },
        "next_step": {
          "type": "string"
        },
        "end": {
          "type": "boolean",
          "default": false
        },
        "seconds": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/choice_rule"
          }
        },
        "default_next": {
          "type": "string"
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/branch"
          }
        },
        "iterator": {
          "$ref": "#/$defs/branch"
        },
        "items_path": {
          "type": "string"
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "description": "Map state's MaxConcurrency: caps how many iterations run at once (e.g. \"maximum parallelism of ten\", \"no more than 10 batches running at once\"). Omit for unbounded concurrency. Only meaningful on a Map step."
        },
        "items_batcher": {
          "type": "object",
          "additionalProperties": false,
          "description": "Map state's ItemBatcher: groups items into fixed-size batches before each iteration (e.g. \"partition into groups of 500\"). Omit if the plan already produces pre-partitioned items itself (a separate partitioning step before the Map) rather than asking the Map state to do the batching.",
          "properties": {
            "max_items_per_batch": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "item_selector": {
          "type": "object",
          "description": "Map ItemSelector: shapes each iterator input. Required when the Map is Distributed or the iterator needs parent-scoped fields (bucket, run_id, config, prior-step outputs) in addition to the raw item. Typical keys: item from $$.Map.Item.Value plus parent fields. Only meaningful on a Map step."
        },
        "distributed": {
          "type": "boolean",
          "description": "When true, this Map is a Distributed Map. Stage 4 emits ProcessorConfig Mode=DISTRIBUTED with ExecutionType=STANDARD. Prefer setting this explicitly when the plan/description says Distributed Map, high fan-out, or 'at once' over a large collection."
        },
        "processor_config": {
          "type": "object",
          "additionalProperties": true,
          "description": "Map ProcessorConfig. For Distributed Map use {\"Mode\": \"DISTRIBUTED\", \"ExecutionType\": \"STANDARD\"}. Inline maps may omit or use {\"Mode\": \"INLINE\"}.",
          "properties": {
            "Mode": {
              "type": "string",
              "enum": ["INLINE", "DISTRIBUTED"]
            },
            "ExecutionType": {
              "type": "string",
              "enum": ["STANDARD", "EXPRESS"]
            }
          }
        },
        "tolerated_failure_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Map ToleratedFailureCount. Set to 0 when the plan requires failing the entire Map if any item fails (failure-intolerant). Only meaningful on a Map step."
        },
        "tolerated_failure_percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Map ToleratedFailurePercentage. Set to 0 when the plan requires failing the entire Map if any item fails. Only meaningful on a Map step."
        },
        "echo": {
          "type": "object",
          "description": "Optional fields to thread forward under this step's result_path when the integration does not return them (e.g. caller-supplied values). Keys are result field names; values are path or constant expressions. Consumed by Stage 4 when merging Output."
        },
        "result_path": {
          "type": "string",
          "description": "ASL ResultPath: JSONPath where this state's result is written on the execution state (e.g. '$.batch'). Use null-equivalent omission to keep prior state; '$' replaces the entire state. Allowed on Task, Parallel, Map, Pass, and Wait."
        },
        "result_selector": {
          "type": "object",
          "description": "ASL ResultSelector: object that reshapes the raw task/parallel/map result before ResultPath is applied. Values may use path endings like 'Field.$' with JSONPath or intrinsic functions (e.g. States.StringToJson($.Body))."
        },
        "error": {
          "type": "string"
        },
        "cause": {
          "type": "string"
        }
      },

      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "Task"
              }
            }
          },
          "then": {
            "required": [
              "service",
              "resource"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Wait"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "seconds"
                ]
              },
              {
                "required": [
                  "timestamp"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Choice"
              }
            }
          },
          "then": {
            "required": [
              "choices"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Parallel"
              }
            }
          },
          "then": {
            "required": [
              "branches"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Map"
              }
            }
          },
          "then": {
            "required": [
              "iterator",
              "items_path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Fail"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "enum": [
                    "Succeed",
                    "Fail",
                    "Choice"
                  ]
                }
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "next_step"
                ]
              },
              {
                "properties": {
                  "end": {
                    "const": true
                  }
                },
                "required": [
                  "end"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
