{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestration-accelerator/schemas/workflow_spec.schema.json",
  "title": "Workflow Specification",
  "description": "The locked, schema-validated document produced by Stage 3.5 enrichment. This is the single source of truth Stage 4 translates into ASL -- nothing in ASL generation should require information that isn't here.",
  "type": "object",
  "required": [
    "name",
    "summary",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-_]{1,80}$",
      "description": "Becomes the Step Functions state machine name. AWS-safe characters only."
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "start_at": {
      "type": "string"
    },
    "merged_step_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Step ids from the input plan that were deliberately merged into a preceding step (e.g. a retry-only step folded into the step it retries) rather than emitted as their own state. Not part of ASL itself -- consumed by enrichment's fidelity check, not by Stage 4."
    },
    "added_step_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "NEW step ids not present in the input plan, added because ASL structurally required a minimal terminal target (Succeed/Fail only) for an outcome the plan never gave its own step. Not part of ASL itself -- consumed by enrichment's fidelity check, not by Stage 4."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "branch": {
      "type": "object",
      "required": [
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "start_at": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "retrier": {
      "type": "object",
      "required": [
        "error_equals"
      ],
      "additionalProperties": false,
      "properties": {
        "error_equals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 0,
          "default": 3
        },
        "backoff_rate": {
          "type": "number",
          "minimum": 1,
          "default": 2.0
        }
      }
    },
    "catcher": {
      "type": "object",
      "required": [
        "error_equals",
        "next_step"
      ],
      "additionalProperties": false,
      "properties": {
        "error_equals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "next_step": {
          "type": "string"
        }
      }
    },
    "choice_rule": {
      "type": "object",
      "required": [
        "condition",
        "next_step"
      ],
      "additionalProperties": false,
      "properties": {
        "condition": {
          "type": "string"
        },
        "next_step": {
          "type": "string"
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{1,80}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "Task",
            "Choice",
            "Wait",
            "Parallel",
            "Map",
            "Succeed",
            "Fail",
            "Pass"
          ]
        },
        "description": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "retry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/retrier"
          }
        },
        "catch": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catcher"
          }
        },
        "next_step": {
          "type": "string"
        },
        "end": {
          "type": "boolean",
          "default": false
        },
        "seconds": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/choice_rule"
          }
        },
        "default_next": {
          "type": "string"
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/branch"
          }
        },
        "iterator": {
          "$ref": "#/$defs/branch"
        },
        "items_path": {
          "type": "string"
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "description": "Map state's MaxConcurrency: caps how many iterations run at once (e.g. \"maximum parallelism of ten\", \"no more than 10 batches running at once\"). Omit for unbounded concurrency. Only meaningful on a Map step."
        },
        "items_batcher": {
          "type": "object",
          "additionalProperties": false,
          "description": "Map state's ItemBatcher: groups items into fixed-size batches before each iteration (e.g. \"partition into groups of 500\"). Omit if the plan already produces pre-partitioned items itself (a separate partitioning step before the Map) rather than asking the Map state to do the batching.",
          "properties": {
            "max_items_per_batch": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "error": {
          "type": "string"
        },
        "cause": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "Task"
              }
            }
          },
          "then": {
            "required": [
              "service",
              "resource"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Wait"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "seconds"
                ]
              },
              {
                "required": [
                  "timestamp"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Choice"
              }
            }
          },
          "then": {
            "required": [
              "choices"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Parallel"
              }
            }
          },
          "then": {
            "required": [
              "branches"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Map"
              }
            }
          },
          "then": {
            "required": [
              "iterator",
              "items_path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Fail"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "enum": [
                    "Succeed",
                    "Fail",
                    "Choice"
                  ]
                }
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "next_step"
                ]
              },
              {
                "properties": {
                  "end": {
                    "const": true
                  }
                },
                "required": [
                  "end"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
